# WayPoint frontend — environment template.
# Copy to `.env` for local dev. `.env` is gitignored; this `.example` is tracked.

# Toggle the mock data layer.
#   true  = use local offline mock data (default — safe for demos, no backend needed)
#   false = call the real backend at VITE_API_BASE_URL
VITE_USE_MOCK=true

# Backend base URL (FastAPI on Render). No trailing slash.
# Local backend dev: http://localhost:8000
VITE_API_BASE_URL=http://localhost:8000
