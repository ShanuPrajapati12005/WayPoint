# WayPoint backend — environment template.
# Copy to `.env` in the backend project root and fill in real values.
# NEVER commit the real .env (it holds secrets). Only this .example file is tracked.

# ─── LLM ───
LLM_API_KEY=your-llm-key-here
LLM_MODEL=your-model-id

# ─── Supabase ───
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-side only, secret
SUPABASE_ANON_KEY=your-anon-key                    # optional, if you ever use client-side reads

# ─── Auth ───
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ─── CORS ───
# The deployed frontend origin (Vercel). localhost:5180 is added in code for dev.
FRONTEND_ORIGIN=https://your-app.vercel.app

# ─── Server ───
PORT=8000
